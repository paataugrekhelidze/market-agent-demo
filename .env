OPENAI_API_KEY="" # required
COHERE_API_KEY="" # optional (default, local model)
ENCODER_MODEL="sentence-transformers/all-MiniLM-L6-v2" # optional, only used if cohere api not specified
AGENT_CONCURRENCY_LIMIT="3" # optional, concurrent agent pipelines allowed by prefect. (default: 3)
PIPELINE_QUEUE_TIMEOUT="60" # optional, wait time in he queue in seconds. (default: 60)